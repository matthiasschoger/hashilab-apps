# Register volume with
#  nomad volume register example.volume
type      = "csi"
id        = "paperless-postgres"
name      = "Paperless-Postgres"
plugin_id = "iscsi"

capacity_min = "1GiB"
capacity_max = "2GiB"

capability {
  access_mode     = "single-node-writer"
  attachment_mode = "file-system"
}

mount_options {
  fs_type     = "btrfs"
  mount_flags = ["noatime"]
}

parameters {
  location = "/volume2"
}